{
  "name": "extract-c4-from-figjam",
  "version": "1.0.0",
  "private": true,
  "description": "FigJam plugin that extracts relations between shapes (via connectors) and exports them as Mermaid C4 diagram code.",
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "esbuild src/code.ts --bundle --target=es2017 --outfile=dist/code.js",
    "build:ui": "node scripts/build-ui.js",
    "watch": "esbuild src/code.ts --bundle --target=es2017 --outfile=dist/code.js --watch & node scripts/build-ui.js --watch & wait",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.99.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
